{
  "dialogue_id": "emma_chapter_7_final",
  "npc_id": "npc_emma",
  "chapter": 7,
  "day": 7,
  "location": "tv_studio",
  "title": "Final Debate & Vote - Emma",
  "description": "R. John encounters Emma during the final debate day.",
  "mood_baseline": {"receptive": 40, "playful": 50, "bold": 30},
  "nodes": [
    {"id": "start", "text": "Emma is waiting outside the TV studio. She looks nervous. 'I heard about the investigation. Is it true?'", "choices": [
      {"text": "Say it's complicated", "next": "complicated_emma"},
      {"text": "Ask if she believes it", "next": "believes_it"},
      {"text": "Change the subject", "next": "change_subject_emma"}
    ]},
    {"id": "complicated_emma", "text": "Emma: 'Everything with you is complicated.' She looks down. 'But I still... care.'", "mood_effect": {"receptive": 20, "playful": 5}, "consequence": {"attraction": 15, "risk": 20}, "choices": [
      {"text": "Say he cares too", "next": "cares_too"},
      {"text": "Ask what she wants", "next": "wants_emma"}
    ]},
    {"id": "believes_it", "text": "Emma: 'I want to not believe it. But... there's so much.' Her eyes are wet.", "mood_effect": {"receptive": 15, "playful": -10}, "consequence": {"attraction": -5, "risk": 25}, "choices": [
      {"text": "Say some of it is true", "next": "some_true"},
      {"text": "Deny everything", "next": "deny_emma"}
    ]},
    {"id": "change_subject_emma", "text": "Emma: 'No. We need to talk about this. Please.'", "mood_effect": {"receptive": 15, "playful": -5}, "consequence": {"attraction": 5, "risk": 20}, "choices": [
      {"text": "Agree to talk", "next": "agree_talk"},
      {"text": "Say there's no time", "next": "no_time"}
    ]},
    {"id": "cares_too", "text": "Emma: 'Then prove it. Stand up to them. Don't let them destroy you.'", "mood_effect": {"receptive": 25, "bold": 15}, "consequence": {"attraction": 20, "risk": 25}, "choices": [
      {"text": "Say he'll fight", "next": "will_fight"},
      {"text": "Ask for her support", "next": "her_support"}
    ]},
    {"id": "wants_emma", "text": "Emma: 'I want you to be honest. With me. At least once.'", "mood_effect": {"receptive": 25, "bold": 10}, "consequence": {"attraction": 15, "risk": 20}, "choices": [
      {"text": "Be honest now", "next": "honest_now"},
      {"text": "Say honesty is dangerous", "next": "honesty_dangerous"}
    ]},
    {"id": "some_true", "text": "Emma: 'Which parts?' She looks at you directly. 'I deserve to know.'", "mood_effect": {"receptive": 20, "bold": 15}, "consequence": {"attraction": 10, "risk": 30}, "choices": [
      {"text": "Tell her the truth", "next": "tell_truth"},
      {"text": "Say it doesn't matter", "next": "doesnt_matter"}
    ]},
    {"id": "deny_emma", "text": "Emma: 'Then why does everyone believe it? Why does it feel true?'", "mood_effect": {"receptive": 10, "playful": -15}, "consequence": {"attraction": -10, "risk": 30}, "choices": [
      {"text": "Say people believe lies", "next": "believe_lies"},
      {"text": "Ask her to trust you", "next": "trust_you"}
    ]},
    {"id": "agree_talk", "text": "Emma: 'Thank you. I just... I need to understand.'", "mood_effect": {"receptive": 20, "playful": 5}, "consequence": {"attraction": 10, "risk": 20}, "choices": [
      {"text": "Say he'll explain", "next": "explain_emma"},
      {"text": "Ask what she wants to understand", "next": "understand_what"}
    ]},
    {"id": "no_time", "text": "Emma: 'There's always time for this. For us.'", "mood_effect": {"receptive": 20, "bold": 15}, "consequence": {"attraction": 15, "risk": 25}, "choices": [
      {"text": "Say she's right", "next": "shes_right"},
      {"text": "Ask for five minutes", "next": "five_minutes"}
    ]},
    {"id": "will_fight", "text": "Emma: 'Then I'll be here. Supporting you. No matter what.'", "mood_effect": {"receptive": 30, "bold": 20}, "consequence": {"attraction": 25, "risk": 30}, "ending": "supportive_emma", "choices": [
      {"text": "Thank her", "next": "thank_emma"}
    ]},
    {"id": "her_support", "text": "Emma: 'You have it. Always. But you need to fight back.'", "mood_effect": {"receptive": 25, "bold": 20}, "consequence": {"attraction": 20, "risk": 25}, "choices": [
      {"text": "Promise to fight", "next": "promise_fight"}
    ]},
    {"id": "honest_now", "text": "Emma: 'Finally. Tell me everything. Please.'", "mood_effect": {"receptive": 30, "bold": 15}, "consequence": {"attraction": 20, "risk": 30}, "choices": [
      {"text": "Tell her", "next": "tell_her"}
    ]},
    {"id": "honesty_dangerous", "text": "Emma: 'More dangerous than lies? Than losing everything?'", "mood_effect": {"receptive": 20, "bold": 20}, "consequence": {"attraction": 15, "risk": 25}, "choices": [
      {"text": "Say yes", "next": "say_yes"},
      {"text": "Say no", "next": "say_no"}
    ]},
    {"id": "tell_truth", "text": "Emma listens silently. When you finish, she nods. 'Thank you for trusting me.'", "mood_effect": {"receptive": 35, "bold": 20}, "consequence": {"attraction": 30, "risk": 40}, "ending": "truth_told", "choices": [
      {"text": "Ask what she thinks", "next": "what_thinks"}
    ]},
    {"id": "doesnt_matter", "text": "Emma: 'It matters to me. It matters to us.'", "mood_effect": {"receptive": 25, "bold": 15}, "consequence": {"attraction": 15, "risk": 25}, "choices": [
      {"text": "Say she's right", "next": "right_emma"},
      {"text": "Ask her to let it go", "next": "let_go"}
    ]},
    {"id": "believe_lies", "text": "Emma: 'Then give me the truth. So I can choose what to believe.'", "mood_effect": {"receptive": 25, "bold": 20}, "consequence": {"attraction": 20, "risk": 30}, "choices": [
      {"text": "Give her the truth", "next": "give_truth"}
    ]},
    {"id": "trust_you", "text": "Emma: 'I do. But trust isn't blind. Not anymore.'", "mood_effect": {"receptive": 20, "bold": 15}, "consequence": {"attraction": 15, "risk": 25}, "choices": [
      {"text": "Say he understands", "next": "understand_emma"},
      {"text": "Ask what she needs", "next": "needs_emma"}
    ]},
    {"id": "explain_emma", "text": "You explain. Emma listens, her expression softening.", "mood_effect": {"receptive": 30, "bold": 15}, "consequence": {"attraction": 25, "risk": 30}, "ending": "explained_emma", "choices": [
      {"text": "Ask if she understands", "next": "understands"}
    ]},
    {"id": "understand_what", "text": "Emma: 'Why you did it. Why you risked everything.'", "mood_effect": {"receptive": 25, "bold": 15}, "consequence": {"attraction": 20, "risk": 25}, "choices": [
      {"text": "Explain why", "next": "explain_why"}
    ]},
    {"id": "shes_right", "text": "Emma: 'Then let's talk. Here. Now.'", "mood_effect": {"receptive": 25, "bold": 20}, "consequence": {"attraction": 20, "risk": 25}, "ending": "talk_now", "choices": [
      {"text": "Start talking", "next": "start_talking"}
    ]},
    {"id": "five_minutes", "text": "Emma: 'Five minutes. Then you go in there and win.'", "mood_effect": {"receptive": 25, "bold": 20}, "consequence": {"attraction": 20, "risk": 25}, "ending": "five_min_talk", "choices": [
      {"text": "Use the time wisely", "next": "use_wisely_emma"}
    ]},
    {"id": "thank_emma": "text": "Emma: 'Go win. I'll be watching.' She kisses your cheek.", "mood_effect": {"receptive": 30, "bold": 20}, "consequence": {"attraction": 25, "risk": 30}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "promise_fight": "text": "Emma: 'Then I'm with you. All the way.'", "mood_effect": {"receptive": 30, "bold": 25}, "consequence": {"attraction": 30, "risk": 35}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 35}},
    {"id": "tell_her": "text": "You tell her. Emma doesn't cry. She just nods. 'Now we can move forward.'", "mood_effect": {"receptive": 35, "bold": 25}, "consequence": {"attraction": 35, "risk": 45}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 45}},
    {"id": "say_yes": "text": "Emma: 'Then maybe we deserve what's coming.'", "mood_effect": {"receptive": 15, "bold": 10}, "consequence": {"attraction": -5, "risk": 30}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "say_no": "text": "Emma: 'Then be honest. Now. While it still matters.'", "mood_effect": {"receptive": 30, "bold": 20}, "consequence": {"attraction": 25, "risk": 35}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 35}},
    {"id": "what_thinks": "text": "Emma: 'I think... I still believe in you. Despite everything.'", "mood_effect": {"receptive": 35, "bold": 20}, "consequence": {"attraction": 30, "risk": 40}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 40}},
    {"id": "right_emma": "text": "Emma: 'Then let's deal with it. Together.'", "mood_effect": {"receptive": 30, "bold": 20}, "consequence": {"attraction": 25, "risk": 30}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "let_go": "text": "Emma: 'I can't. Not until I understand.'", "mood_effect": {"receptive": 25, "bold": 15}, "consequence": {"attraction": 15, "risk": 25}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "give_truth": "text": "You give her the truth. Emma takes it without flinching.", "mood_effect": {"receptive": 35, "bold": 25}, "consequence": {"attraction": 35, "risk": 45}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 45}},
    {"id": "understand_emma": "text": "Emma: 'Good. Then you'll understand when I say I'm still here.'", "mood_effect": {"receptive": 30, "bold": 20}, "consequence": {"attraction": 25, "risk": 30}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "needs_emma": "text": "Emma: 'Proof. Evidence. Something real.'", "mood_effect": {"receptive": 25, "bold": 20}, "consequence": {"attraction": 20, "risk": 30}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "understands": "text": "Emma: 'I do. And I forgive you. Now go win.'", "mood_effect": {"receptive": 35, "bold": 25}, "consequence": {"attraction": 35, "risk": 40}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 40}},
    {"id": "explain_why": "text": "You explain why. Emma understands more than you expected.", "mood_effect": {"receptive": 30, "bold": 20}, "consequence": {"attraction": 30, "risk": 35}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 35}},
    {"id": "talk_now": "text": "You talk. Emma listens. The debate can wait.", "mood_effect": {"receptive": 30, "bold": 20}, "consequence": {"attraction": 25, "risk": 30}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "use_wisely_emma": "text": "You use the five minutes wisely. Emma smiles when you finish.", "mood_effect": {"receptive": 30, "bold": 25}, "consequence": {"attraction": 30, "risk": 35}, "ending": "chapter_7_emma_complete", "reputation_effect": {"scandal_risk": 35}}
  ],

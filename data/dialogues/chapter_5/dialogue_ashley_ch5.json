{
  "dialogue_id": "ashley_chapter_5",
  "npc_id": "npc_ashley",
  "chapter": 5,
  "day": 5,
  "location": "after_party",
  "title": "Congress Day 2 - Ashley",
  "description": "R. John meets Ashley, Maria's friend, at the congress after-party.",
  "mood_baseline": {"receptive": 50, "playful": 60, "bold": 40},
  "nodes": [
    {"id": "start", "text": "Ashley spots you at the bar. She's 25, social, gossipy, and clearly had a few drinks. 'Oh my god, you're Maria's boss!'", "choices": [
      {"text": "Say you've heard about her from Maria", "next": "heard_maria"},
      {"text": "Offer to buy her a drink", "next": "buy_drink"},
      {"text": "Ask how she knows Maria", "next": "know_maria"}
    ]},
    {"id": "heard_maria", "text": "Ashley: 'All good things, I hope!' She laughs. 'Maria never shuts up about work. But she never mentions the handsome stuff.'", "mood_effect": {"playful": 20, "receptive": 15}, "consequence": {"attraction": 20, "risk": 10}, "choices": [
      {"text": "Say Maria is very professional", "next": "professional_maria"},
      {"text": "Ask what else Maria says", "next": "what_else"}
    ]},
    {"id": "buy_drink", "text": "Ashley: 'I won't say no! Make it a double.' She grins. 'Long day watching politicians pretend to care.'", "mood_effect": {"playful": 25, "bold": 10}, "choices": [
      {"text": "Toast to honest people", "next": "toast_honest"},
      {"text": "Ask what she does", "next": "what_does"}
    ]},
    {"id": "know_maria", "text": "Ashley: 'College roommates! We tell each other everything.' She winks. 'Well, almost everything.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 20, "risk": 15}, "choices": [
      {"text": "Ask what she doesn't tell", "next": "doesnt_tell"},
      {"text": "Say you have secrets too", "next": "secrets_too"}
    ]},
    {"id": "professional_maria", "text": "Ashley: 'Too professional. That's her problem. You should loosen her up.' She sips her drink.", "mood_effect": {"receptive": 15, "bold": 10}, "consequence": {"attraction": 15, "risk": 10}, "choices": [
      {"text": "Say you've tried", "next": "tried"},
      {"text": "Ask for advice", "next": "advice_ash"}
    ]},
    {"id": "what_else", "text": "Ashley: 'That you work too much. That you're never around. That you're... interesting.' She leans in.", "mood_effect": {"receptive": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Ask what she finds interesting", "next": "finds_interesting"},
      {"text": "Say interesting is an understatement", "next": "understatement"}
    ]},
    {"id": "toast_honest", "text": "Ashley: 'To honesty!' She clinks glasses. 'Though I guess politicians and honesty are... complicated.'", "mood_effect": {"playful": 20, "receptive": 10}, "choices": [
      {"text": "Say you're more honest than most", "next": "honest_most"},
      {"text": "Admit she has a point", "next": "has_point"}
    ]},
    {"id": "what_does", "text": "Ashley: 'Social media manager. Freelance. I make boring people look fun.' She studies you. 'You're not boring.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Ask if she could make you look fun", "next": "make_fun"},
      {"text": "Say you prefer authentic", "next": "prefer_authentic"}
    ]},
    {"id": "doesnt_tell", "text": "Ashley: 'Like how she has a crush on—' She stops. 'Oops. Never mind.'", "mood_effect": {"bold": 20, "playful": 20}, "consequence": {"attraction": 25, "risk": 20}, "choices": [
      {"text": "Press gently for more", "next": "press_gently"},
      {"text": "Change the subject", "next": "change_subject"}
    ]},
    {"id": "secrets_too", "text": "Ashley: 'Ooh, mysterious. I like secrets. Especially juicy ones.' She grins.", "mood_effect": {"bold": 20, "playful": 20}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Offer to share one privately", "next": "share_privately"},
      {"text": "Ask about her secrets", "next": "her_secrets"}
    ]},
    {"id": "tried", "text": "Ashley: 'Not hard enough, obviously. She needs someone who... appreciates her.'", "mood_effect": {"receptive": 15, "bold": 10}, "consequence": {"attraction": 20, "risk": 15}, "choices": [
      {"text": "Say he appreciates her a lot", "next": "appreciate_alot"},
      {"text": "Ask Ashley to help", "next": "help_ash"}
    ]},
    {"id": "advice_ash", "text": "Ashley: 'Take her out. Not for work. For fun. And don't take no for an answer.' She winks.", "mood_effect": {"bold": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 20}, "choices": [
      {"text": "Say he might do that", "next": "might_do"},
      {"text": "Ask about Ashley's dating advice in general", "next": "dating_advice"}
    ]},
    {"id": "finds_interesting", "text": "Ashley: 'The way you command a room. The power thing. It's... hot.' She says it casually.", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Say power is overrated", "next": "power_overrated"},
      {"text": "Ask what else she finds hot", "next": "else_hot"}
    ]},
    {"id": "understatement", "text": "Ashley: 'Confident too. I like that.' She finishes her drink. 'Another?'", "mood_effect": {"playful": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Order another round", "next": "another_round"},
      {"text": "Suggest moving somewhere quieter", "next": "quieter_place"}
    ]},
    {"id": "honest_most", "text": "Ashley: 'Prove it. Tell me something real. Something no one knows.'", "mood_effect": {"bold": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 20}, "choices": [
      {"text": "Share something personal", "next": "share_personal"},
      {"text": "Say some secrets are too valuable", "next": "too_valuable"}
    ]},
    {"id": "has_point", "text": "Ashley: 'At least you admit it. That's refreshing.' She smiles.", "mood_effect": {"receptive": 15, "playful": 10}, "consequence": {"attraction": 20, "risk": 10}, "choices": [
      {"text": "Say honesty is underrated", "next": "honesty_underrated"},
      {"text": "Ask what else is refreshing", "next": "else_refreshing"}
    ]},
    {"id": "make_fun", "text": "Ashley: 'Easily. But my rates are high. Very high.' She smirks.", "mood_effect": {"bold": 20, "playful": 20}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Say money is no object", "next": "money_no_object"},
      {"text": "Ask about alternative payment", "next": "alt_payment"}
    ]},
    {"id": "prefer_authentic", "text": "Ashley: 'Authentic is overrated. Everyone wants to look good. Even you.'", "mood_effect": {"bold": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Admit she's right", "next": "shes_right"},
      {"text": "Say he's working on it", "next": "working_on_it"}
    ]},
    {"id": "press_gently", "text": "Ashley: 'Well... she may have mentioned you're single. And that she finds you attractive.' She giggles.", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 25}, "choices": [
      {"text": "Say Maria has good taste", "next": "good_taste"},
      {"text": "Ask what else she mentioned", "next": "mentioned_else"}
    ]},
    {"id": "change_subject", "text": "Ashley: 'Smart. Some things are better left unsaid. Like how hot you look in that suit.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Thank her for the compliment", "next": "thank_compliment"},
      {"text": "Return the compliment", "next": "return_compliment"}
    ]},
    {"id": "share_privately", "text": "Ashley: 'I love private secrets. My room is just upstairs. Room 214.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "room_214", "choices": [
      {"text": "Say you'll come by later", "next": "come_later"}
    ]},
    {"id": "her_secrets", "text": "Ashley: 'I have many. But I only share with people I trust. Or... people I like.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Say he'd like to earn that trust", "next": "earn_trust"},
      {"text": "Ask what she likes", "next": "she_likes"}
    ]},
    {"id": "appreciate_alot", "text": "Ashley: 'Then show her. Or... show me how you'd do it. For practice.' She laughs but her eyes are serious.", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "choices": [
      {"text": "Take her up on the offer", "next": "take_offer"},
      {"text": "Say practice makes perfect", "next": "practice_perfect"}
    ]},
    {"id": "help_ash", "text": "Ashley: 'I could. But it'll cost you. Drinks. Dinner. Maybe more.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Agree to her terms", "next": "agree_terms"},
      {"text": "Negotiate", "next": "negotiate_ash"}
    ]},
    {"id": "might_do", "text": "Ashley: 'Do it. Life's too short for hesitation.' She finishes her drink.", "mood_effect": {"bold": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Say she's wise beyond her years", "next": "wise_years"},
      {"text": "Ask about her philosophy on life", "next": "philosophy"}
    ]},
    {"id": "dating_advice", "text": "Ashley: 'Go for what you want. Don't play games. And never apologize for wanting someone.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Say he likes her philosophy", "next": "like_philosophy"},
      {"text": "Ask if she's single", "next": "single_ash"}
    ]},
    {"id": "power_overrated", "text": "Ashley: 'Says the powerful man. Cute.' She laughs. 'But I know what I like.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Ask what she likes", "next": "what_likes"},
      {"text": "Say he's curious", "next": "curious_ash"}
    ]},
    {"id": "else_hot", "text": "Ashley: 'Confidence. Intelligence. The ability to keep a secret.' She holds your gaze.", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Say he has all three", "next": "have_all_three"},
      {"text": "Offer a demonstration", "next": "demonstration"}
    ]},
    {"id": "another_round", "text": "Ashley: 'Make it two. We're just getting started.' She smiles.", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Order and continue the conversation", "next": "continue_conv"}
    ]},
    {"id": "quieter_place", "text": "Ashley: 'There's a lounge upstairs. Much quieter. And private.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "lounge_upstairs", "choices": [
      {"text": "Lead the way", "next": "lead_way"}
    ]},
    {"id": "share_personal", "text": "Ashley: 'See? That wasn't so hard. Now I owe you one.' She leans closer.", "mood_effect": {"receptive": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Say he knows how she can repay", "next": "repay"},
      {"text": "Ask for her number instead", "next": "number_ash"}
    ]},
    {"id": "too_valuable", "text": "Ashley: 'Smart. Secrets are currency. Spend them wisely.'", "mood_effect": {"bold": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Say he's a good investor", "next": "good_investor"},
      {"text": "Ask what her most valuable secret is", "next": "valuable_secret"}
    ]},
    {"id": "honesty_underrated", "text": "Ashley: 'Finally, something we agree on. Honesty and... other things.' She winks.", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Ask what other things", "next": "other_things"},
      {"text": "Suggest exploring them", "next": "explore_them"}
    ]},
    {"id": "else_refreshing", "text": "Ashley: 'Cold showers. Honest conversations. Men who know what they want.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Say he knows what he wants", "next": "knows_wants"},
      {"text": "Ask if he qualifies", "next": "qualifies"}
    ]},
    {"id": "money_no_object", "text": "Ashley: 'Good. Then we'll have fun. My place. Tonight. I'll show you my portfolio.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "portfolio_show", "choices": [
      {"text": "Ask for the address", "next": "address_ash"}
    ]},
    {"id": "alt_payment", "text": "Ashley: 'I accept... creative arrangements. Dinner. Favors. Experiences.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "choices": [
      {"text": "Propose an experience", "next": "propose_exp"},
      {"text": "Ask what kind of experiences", "next": "kind_exp"}
    ]},
    {"id": "shes_right", "text": "Ashley: 'Of course I am. Now let's work on your image. Starting with that tie.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Let her adjust it", "next": "adjust_tie"},
      {"text": "Say she can do more than that", "next": "more_than"}
    ]},
    {"id": "working_on_it", "text": "Ashley: 'Good. Authenticity is sexy. In its own way.' She smiles.", "mood_effect": {"receptive": 15, "bold": 10}, "consequence": {"attraction": 20, "risk": 10}, "choices": [
      {"text": "Ask what else is sexy", "next": "else_sexy"},
      {"text": "Say he's taking notes", "next": "taking_notes"}
    ]},
    {"id": "good_taste", "text": "Ashley: 'She does. But she's too shy to act on it. Unlike me.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "choices": [
      {"text": "Ask what she'd do", "next": "shed_do"},
      {"text": "Say he's intrigued", "next": "intrigued_ash"}
    ]},
    {"id": "mentioned_else", "text": "Ashley: 'That you work too much. That you need someone to... relax you.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Say she's not wrong", "next": "not_wrong"},
      {"text": "Ask if Ashley volunteers", "next": "volunteers"}
    ]},
    {"id": "thank_compliment", "text": "Ashley: 'Just calling it like I see it. And I see a lot.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Say he's flattered", "next": "flattered"},
      {"text": "Ask what else she sees", "next": "else_sees"}
    ]},
    {"id": "return_compliment", "text": "Ashley: 'Why thank you, Senator. You're not so bad yourself.' She twirls her hair.", "mood_effect": {"playful": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Say she's making him blush", "next": "blushing"},
      {"text": "Suggest continuing this elsewhere", "next": "continue_elsewhere"}
    ]},
    {"id": "earn_trust", "text": "Ashley: 'Then buy me another drink. And don't leave until I tell you.'", "mood_effect": {"receptive": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Order and settle in", "next": "settle_in"}
    ]},
    {"id": "she_likes", "text": "Ashley: 'Adventurous men. Men who take charge. Men who... don't ask twice.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "choices": [
      {"text": "Take charge now", "next": "take_charge"},
      {"text": "Ask for specifics", "next": "specifics"}
    ]},
    {"id": "take_offer", "text": "Ashley: 'Bold. I like it. My room. 214. Give me 10 minutes.'", "mood_effect": {"bold": 35, "receptive": 30}, "consequence": {"attraction": 40, "risk": 30}, "ending": "room_214_offer", "choices": [
      {"text": "Wait and then head up", "next": "head_up"}
    ]},
    {"id": "practice_perfect", "text": "Ashley: 'Exactly. So let's practice. Now. My room's free.'", "mood_effect": {"bold": 35, "receptive": 30}, "consequence": {"attraction": 40, "risk": 30}, "ending": "practice_room", "choices": [
      {"text": "Ask for the room number", "next": "room_num"}
    ]},
    {"id": "agree_terms", "text": "Ashley: 'Then it's a deal. Dinner first. Then... we'll see.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "dinner_deal", "choices": [
      {"text": "Suggest a restaurant", "next": "suggest_restaurant"}
    ]},
    {"id": "negotiate_ash", "text": "Ashley: 'I'm reasonable. For the right person.' She smiles.", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Make his case", "next": "make_case"},
      {"text": "Ask what makes someone right", "next": "makes_right"}
    ]},
    {"id": "wise_years", "text": "Ashley: 'I'm 25. Old enough to know better, young enough not to care.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Say that's a dangerous combination", "next": "dangerous_combo"},
      {"text": "Ask what else she doesn't care about", "next": "doesnt_care"}
    ]},
    {"id": "philosophy", "text": "Ashley: 'YOLO, but make it strategic. Seize the day, but cover your tracks.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Say she'd make a good politician", "next": "good_politician"},
      {"text": "Ask if she's single", "next": "is_single"}
    ]},
    {"id": "like_philosophy", "text": "Ashley: 'Then you'll love me. I'm full of good ideas.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Ask for more ideas", "next": "more_ideas"},
      {"text": "Suggest testing them", "next": "testing_them"}
    ]},
    {"id": "single_ash", "text": "Ashley: 'Currently? Yes. Happily? Also yes. But I'm flexible.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Ask what would make her unhappy", "next": "make_unhappy"},
      {"text": "Say he might change that", "next": "change_that"}
    ]},
    {"id": "what_likes", "text": "Ashley: 'I told you. Power. Confidence. Men who don't hesitate.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "choices": [
      {"text": "Say he doesn't hesitate", "next": "no_hesitate"},
      {"text": "Demonstrate", "next": "demonstrate_ash"}
    ]},
    {"id": "curious_ash", "text": "Ashley: 'Curiosity killed the cat. But satisfaction brought it back.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "choices": [
      {"text": "Say he's willing to risk it", "next": "willing_risk"},
      {"text": "Ask for a preview", "next": "preview"}
    ]},
    {"id": "have_all_three", "text": "Ashley: 'Prove it. Three traits, three demonstrations. Starting now.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "three_demos", "choices": [
      {"text": "Start with confidence", "next": "start_confidence"}
    ]},
    {"id": "demonstration", "text": "Ashley: 'I like the way you think. My room. 214. Demonstrate away.'", "mood_effect": {"bold": 35, "receptive": 30}, "consequence": {"attraction": 40, "risk": 30}, "ending": "demonstration_room", "choices": [
      {"text": "Head upstairs", "next": "go_upstairs"}
    ]},
    {"id": "continue_conv", "text": "Ashley: 'So, about that image consultation...'", "mood_effect": {"playful": 15, "receptive": 10}, "consequence": {"attraction": 20, "risk": 10}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 10}},
    {"id": "lead_way": "text": "Ashley leads you to the elevator. 'This is where it gets interesting.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "repay": "text": "Ashley: 'I'm listening. And I'm very... receptive to creative repayment.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "number_ash": "text": "Ashley gives you her number. 'Text me. I respond fast.'", "mood_effect": {"receptive": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 15}},
    {"id": "good_investor": "text": "Ashley: 'Then invest in me. High returns guaranteed.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "valuable_secret": "text": "Ashley: 'That I never turn down an interesting proposition.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "other_things": "text": "Ashley: 'You'll find out. If you're good.' She winks.", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "explore_them": "text": "Ashley: 'Then let's explore. My place. Now.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "knows_wants": "text": "Ashley: 'Then go get it. Or should I come to you?'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "qualifies": "text": "Ashley: 'You might. Let's find out.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "address_ash": "text": "Ashley texts you the address. 'Don't be late. I hate waiting.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "propose_exp": "text": "Ashley: 'I'm listening. And I have a very active imagination.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "kind_exp": "text": "Ashley: 'The fun kind. The kind you tell your friends about. Eventually.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "adjust_tie": "text": "Ashley adjusts your tie. Her fingers linger. 'There. Much better.'", "mood_effect": {"receptive": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 15}},
    {"id": "more_than": "text": "Ashley: 'I can do much more than that. Want to see?'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "else_sexy": "text": "Ashley: 'Surprises. Spontaneity. Men who take initiative.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "taking_notes": "text": "Ashley: 'Good student. Now let's see if you can apply the lessons.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "shed_do": "text": "Ashley: 'Act on it. Immediately. No second-guessing.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "intrigued_ash": "text": "Ashley: 'Then you'll love what I have in mind.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "not_wrong": "text": "Ashley: 'Then let me help. I'm very good at relaxing people.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "volunteers": "text": "Ashley: 'Always. For the right cause.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "flattered": "text": "Ashley: 'Don't be. Just be... available.'", "mood_effect": {"bold": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 15}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 15}},
    {"id": "else_sees": "text": "Ashley: 'Potential. Lots of it. Untapped.'", "mood_effect": {"bold": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 15}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 15}},
    {"id": "blushing": "text": "Ashley: 'Cute. Now let's make you blush for other reasons.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "continue_elsewhere": "text": "Ashley: 'I was hoping you'd say that. My room's free.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "settle_in": "text": "You settle in for a long conversation. Ashley is entertaining.", "mood_effect": {"receptive": 15, "playful": 10}, "consequence": {"attraction": 20, "risk": 10}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 10}},
    {"id": "take_charge": "text": "Ashley: 'Finally. I was wondering when you'd stop asking.'", "mood_effect": {"bold": 35, "receptive": 30}, "consequence": {"attraction": 40, "risk": 30}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "specifics": "text": "Ashley: 'You'll learn. The hard way, if necessary.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "head_up": "text": "You wait 10 minutes, then head to room 214.", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "room_num": "text": "Ashley: '214. Don't knock. Just come in.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "suggest_restaurant": "text": "Ashley names a place. '8 PM. Don't keep me waiting.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "make_case": "text": "Ashley listens intently. 'Not bad. Not bad at all.'", "mood_effect": {"bold": 20, "receptive": 15}, "consequence": {"attraction": 25, "risk": 15}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 15}},
    {"id": "makes_right": "text": "Ashley: 'Confidence. Charm. And the ability to keep a secret.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "dangerous_combo": "text": "Ashley: 'The best kind. Want to find out?'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "doesnt_care": "text": "Ashley: 'Consequences. Regrets. Other people's opinions.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "good_politician": "text": "Ashley: 'I'd be terrifying. Luckily for you, I have other plans.'", "mood_effect": {"playful": 20, "bold": 15}, "consequence": {"attraction": 25, "risk": 15}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 15}},
    {"id": "is_single": "text": "Ashley: 'For now. But I'm flexible.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "more_ideas": "text": "Ashley: 'I have many. But they're better demonstrated than described.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "testing_them": "text": "Ashley: 'Then let's test. My place. Now.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "make_unhappy": "text": "Ashley: 'Boredom. Dishonesty. Men who can't make up their minds.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "change_that": "text": "Ashley: 'I'd like to see you try.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "no_hesitate": "text": "Ashley: 'Then prove it. Now.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "demonstrate_ash": "text": "Ashley: 'Please do. I'm a very visual learner.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "willing_risk": "text": "Ashley: 'Good. Risk is where the fun is.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "preview": "text": "Ashley: 'Previews cost extra. But you look like you can afford it.'", "mood_effect": {"bold": 25, "playful": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}},
    {"id": "three_demos": "text": "Ashley: 'I'm waiting. Impress me.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "start_confidence": "text": "You demonstrate confidence. Ashley smiles. 'Good start.'", "mood_effect": {"bold": 30, "receptive": 25}, "consequence": {"attraction": 35, "risk": 25}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 25}},
    {"id": "demonstration_room": "text": "You head to room 214. Ashley follows shortly after.", "mood_effect": {"bold": 35, "receptive": 30}, "consequence": {"attraction": 40, "risk": 30}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "go_upstairs": "text": "You head upstairs. Ashley is already there waiting.", "mood_effect": {"bold": 35, "receptive": 30}, "consequence": {"attraction": 40, "risk": 30}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 30}},
    {"id": "come_later": "text": "Ashley: 'I'll be waiting. Don't keep me long.'", "mood_effect": {"bold": 25, "receptive": 20}, "consequence": {"attraction": 30, "risk": 20}, "ending": "chapter_5_ashley_complete", "reputation_effect": {"scandal_risk": 20}}
